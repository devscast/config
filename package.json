{
  "author": "bernard-ng <bernard@devscast.tech>",
  "bugs": {
    "url": "https://github.com/devscast/config-ts/issues"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "description": "Typed, immutable, schema-validated configuration for Node.js backend services",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.9",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "publint": "^0.3.23",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "^20.17.0 || >=22.9.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://github.com/devscast/config-ts#readme",
  "keywords": [
    "config",
    "dotenv",
    "env",
    "environment",
    "typescript",
    "validation",
    "yaml",
    "zod"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@devscast/config",
  "packageManager": "bun@1.3.14",
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "overrides": {
    "ajv": "^8.20.0",
    "brace-expansion": "^1.1.18",
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.1",
    "minimatch": "^3.1.5",
    "nanoid": "^3.3.18",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.26",
    "rollup": "^4.62.4",
    "vite": "^7.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devscast/config-ts.git"
  },
  "scripts": {
    "build": "tsup --minify",
    "check:package": "publint --strict && attw --pack --profile esm-only .",
    "dev": "tsup --watch",
    "format": "biome check --write .",
    "lint": "biome check .",
    "prepack": "bun run build",
    "prepare": "husky",
    "release": "npm publish --access public --provenance",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "sideEffects": false,
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "type": "module",
  "version": "2.0.0"
}
